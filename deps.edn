{:paths ["src"]

 ;; the oldest jolt this tree runs on: 0.8.10 fixed the release-build reduce
 ;; miscompile (see lev.tokenizer/lowest-ranked-pair). CI installs the latest
 ;; release (JOLT_PIN only during an incident); this floor makes an older
 ;; runtime refuse the tree instead of building it wrong
 :jolt/min-version "0.8.10"

 ;; data.json reads tokenizer.json / the configs / the safetensors header in
 ;; `jolt prepare`. It needs java.time at load, which jolt-lang/time provides.
 ;; ring-chez-adapter serves lev.server (jolt -M:serve / the built binary);
 ;; ruuter (a data-driven trie router) dispatches its routes.
 :deps {org.clojure/data.json {:mvn/version "2.5.1"}
        askonomm/ruuter {:git/url "https://git.nmm.ee/asko/ruuter.git"
                        :git/tag "v2.1.1"
                        :git/sha "263f868cf19e73ccda7cda6b4d4af1d8fe504749"}
        io.github.jolt-lang/time {:git/url "https://github.com/jolt-lang/time.git"
                                  :git/sha "abeee49974c2c4efa2fa75c96d9a379822c6815f"}
        jolt-lang/ring-chez-adapter {:git/url "https://github.com/jolt-lang/ring-chez-adapter"
                                     :git/tag "v0.7.7"
                                     :git/sha "ff99a9d42761482851e40876c880ac4443cc4d96"}}

 ;; kernels: built from native/lev_kernels.c by the `kernels` task.
 ;; icu: NFC for the tokenizer. mac ships libicucore in the shared cache;
 ;; linux distros name it libicuuc.so.<ver>.
 ;; blas: Accelerate framework on mac, OpenBLAS elsewhere.
 ;; `jolt build` links the kernels statically from the archive so the binary
 ;; is self-contained; run/repl/test load the shared object.
 :jolt/native [{:name "lev_kernels"
                :darwin ["native/liblev_kernels.dylib"]
                :linux  ["native/liblev_kernels.so"]
                :static {:archive "native/liblev_kernels.a"}}
               ;; llama.cpp behind native/lev_llm.c, built by `jolt llama`
               ;; (optional at runtime: without it only the thinker is missing)
               {:name "lev_llm"
                :optional true
                :darwin ["native/liblev_llm.dylib"]
                :linux  ["native/liblev_llm.so"]
                :static {:archive "native/liblev_llm.a"}}
               ;; mlx-c + mlx behind native/lev_mlx.c, built by `jolt mlx`
               ;; (optional, mac only: without it the encoders run on the C
               ;; kernels; MLX finds its kernels in native/mlx.metallib next
               ;; to the dylib, or next to the binary for a jolt build)
               {:name "lev_mlx"
                :optional true
                :darwin ["native/liblev_mlx.dylib"]
                :linux []
                :static {:archive "native/liblev_mlx.a"}}
               ;; what the static llm archive needs at link time: the C++
               ;; runtime and, on mac, the frameworks ggml-metal uses. ld64
               ;; links a framework by its stub when it finds lib<Name>.tbd
               ;; in an -L dir, which native/build_llm.sh symlinks from the
               ;; SDK; at runtime these are dlopened like blas below.
               {:name "cxx"
                :optional true
                :darwin ["libc++.1.dylib"]
                :linux ["libstdc++.so.6"]
                :static {:darwin {:lib "c++"} :linux {:lib "stdc++"}}}
               {:name "metal"
                :optional true
                :darwin ["/System/Library/Frameworks/Metal.framework/Metal"]
                :linux []
                :static {:darwin {:lib "Metal" :libdir "native/frameworks"}}}
               {:name "foundation"
                :optional true
                :darwin ["/System/Library/Frameworks/Foundation.framework/Foundation"]
                :linux []
                :static {:darwin {:lib "Foundation" :libdir "native/frameworks"}}}
               {:name "quartzcore"
                :optional true
                :darwin ["/System/Library/Frameworks/QuartzCore.framework/QuartzCore"]
                :linux []
                :static {:darwin {:lib "QuartzCore" :libdir "native/frameworks"}}}
               {:name "metalkit"
                :optional true
                :darwin ["/System/Library/Frameworks/MetalKit.framework/MetalKit"]
                :linux []
                :static {:darwin {:lib "MetalKit" :libdir "native/frameworks"}}}
               {:name "icu"
                :darwin ["libicucore.dylib"]
                :linux  ["libicuuc.so.76" "libicuuc.so.75" "libicuuc.so.74"
                         "libicuuc.so.72" "libicuuc.so.71" "libicuuc.so"]}
               ;; on mac the static llm archive (ggml-cpu) also needs Accelerate
               ;; at link time, through its stub like the frameworks above
               {:name "blas"
                :darwin ["/System/Library/Frameworks/Accelerate.framework/Accelerate"]
                :linux  ["libopenblas.so.0" "libopenblas.so"]
                :static {:darwin {:lib "Accelerate" :libdir "native/frameworks"}}}]

 :tasks
 {:requires ([babashka.fs :as fs])

  :init (do (def mac? (some? (re-find #"^Mac" (System/getProperty "os.name"))))
            (def kern-lib (str "native/liblev_kernels." (if mac? "dylib" "so")))
            (def kern-archive "native/liblev_kernels.a"))

  kernels
  {:doc "compile native/lev_kernels.c into the kernel library (shared + static archive)"
   :task (if (and (fs/exists? kern-lib) (fs/exists? kern-archive)
                  (empty? (fs/modified-since kern-lib ["native/lev_kernels.c"]))
                  (empty? (fs/modified-since kern-archive ["native/lev_kernels.c"])))
           (println "kernels: up to date -" kern-lib kern-archive)
           (do (shell "cc" "-O2" "-std=c11" "-pthread" "-shared" "-fPIC"
                      "native/lev_kernels.c" "-o" kern-lib)
               (shell "cc" "-O2" "-std=c11" "-pthread" "-c" "-fPIC"
                      "native/lev_kernels.c" "-o" "native/lev_kernels.o")
               (shell "ar" "rcs" kern-archive "native/lev_kernels.o")
               (fs/delete-if-exists "native/lev_kernels.o")
               (println "built:" kern-lib kern-archive)))}

  llama
  {:doc "fetch llama.cpp at the pinned commit of thecodacus/llama.cpp's parallel-decision branch (upstream b10435+617 plus its decision engine) into native/llama.cpp, build it static, wrap it and the engine in native/liblev_llm.* (the thinker's native; LLAMA_CPP_SRC=path fetches from a local checkout holding that commit)"
   :task (let [rev "14d04e755fa28653e87b9a07072892265bdc0fad"
               src (or (System/getenv "LLAMA_CPP_SRC") "https://github.com/thecodacus/llama.cpp")
               dir "native/llama.cpp"
               head (str dir "/.git/HEAD")
               lib (str "native/liblev_llm." (if mac? "dylib" "so"))]
           ;; a checkout of any other commit (the upstream tag this used to
           ;; pin) is replaced, build and all
           (when-not (and (fs/exists? head) (= rev (.trim (slurp head))))
             (fs/delete-tree dir)
             (fs/create-dirs dir)
             (shell "git" "-C" dir "init" "--quiet")
             (shell "git" "-C" dir "fetch" "--quiet" "--depth" "1" src rev)
             (shell "git" "-C" dir "checkout" "--quiet" "FETCH_HEAD"))
           (when-not (fs/exists? (str dir "/build/common/libllama-common.a"))
             (apply shell "cmake" "-S" dir "-B" (str dir "/build") "-DCMAKE_BUILD_TYPE=Release"
                    "-DBUILD_SHARED_LIBS=OFF" "-DGGML_OPENMP=OFF" "-DGGML_NATIVE=OFF" "-DGGML_CPU_ALL_VARIANTS=OFF"
                    "-DLLAMA_BUILD_TESTS=OFF" "-DLLAMA_BUILD_EXAMPLES=OFF" "-DLLAMA_BUILD_TOOLS=OFF"
                    "-DLLAMA_BUILD_SERVER=OFF" "-DLLAMA_BUILD_APP=OFF" "-DLLAMA_CURL=OFF"
                    ;; llama-common (the decision engine's tokenizer and batch
                    ;; helpers) without the network: no https, no subprocess
                    "-DLLAMA_BUILD_COMMON=ON" "-DLLAMA_OPENSSL=OFF" "-DLLAMA_SUBPROCESS=OFF"
                    (if mac? ["-DGGML_METAL=ON" "-DGGML_METAL_EMBED_LIBRARY=ON" "-DGGML_BLAS=OFF"] ["-DGGML_METAL=OFF"]))
             ;; a bare -j is unbounded: every model source at once, which a
             ;; 4-core/7 GB CI runner answers with an OOM kill (exit 143)
             (shell "cmake" "--build" (str dir "/build") "--target" "llama" "llama-common"
                    "--parallel" (str (.availableProcessors (Runtime/getRuntime)))))
           (if (and (fs/exists? lib) (fs/exists? "native/liblev_llm.a")
                    (empty? (fs/modified-since lib ["native/lev_llm.c" "native/lev_llm.h" "native/lev_decision.cpp" "native/lev_clef.cpp" "native/build_llm.sh" head])))
             (println "llm: up to date -" lib "native/liblev_llm.a")
             (shell "sh" "native/build_llm.sh" rev)))}

  mlx
  {:doc "clone mlx-c at the pinned tag into native/mlx-c (it fetches mlx itself), build both static, wrap them in native/liblev_mlx.* with the Metal kernels beside it (the encoders' optional GPU backend, mac only; MLX_C_SRC=path clones from a local checkout)"
   :task (let [tag "v0.6.0"
               src (or (System/getenv "MLX_C_SRC") "https://github.com/ml-explore/mlx-c")
               dir "native/mlx-c"
               lib "native/liblev_mlx.dylib"]
           (when-not mac? (throw (ex-info "the mlx backend is mac only (MLX's GPU backend is Metal)" {})))
           (when-not (fs/exists? (str dir "/CMakeLists.txt"))
             (shell "git" "clone" "--quiet" "--depth" "1" "--branch" tag src dir))
           (when-not (fs/exists? (str dir "/build/libmlxc.a"))
             (shell "cmake" "-S" dir "-B" (str dir "/build") "-DCMAKE_BUILD_TYPE=Release"
                    "-DBUILD_SHARED_LIBS=OFF" "-DMLX_C_BUILD_EXAMPLES=OFF" "-DMLX_BUILD_GGUF=OFF"
                    "-DMLX_BUILD_SAFETENSORS=OFF" "-DMLX_BUILD_TESTS=OFF" "-DMLX_BUILD_EXAMPLES=OFF"
                    "-DMLX_BUILD_PYTHON_STUBS=OFF")
             (shell "cmake" "--build" (str dir "/build")
                    "--parallel" (str (.availableProcessors (Runtime/getRuntime)))))
           (if (and (fs/exists? lib) (fs/exists? "native/liblev_mlx.a") (fs/exists? "native/mlx.metallib")
                    (empty? (fs/modified-since lib ["native/lev_mlx.c" "native/build_mlx.sh"])))
             (println "mlx: up to date -" lib "native/liblev_mlx.a native/mlx.metallib")
             (shell "sh" "native/build_mlx.sh")))}

  binary
  {:doc "build the standalone HTTP server ./lev-server (kernels and llama.cpp linked in, mlx too when native/liblev_mlx.a is built) and self-test it against golden/"
   :depends [kernels llama]
   :task (do (shell "jolt" "build" "-m" "lev.server" "-o" "lev-server")
             ;; the suite runs interpreted; the AOT build must prove itself
             (shell "./lev-server" "--self-test" "--data" "data" "--golden" "golden")
             (println "built: ./lev-server  (run: ./lev-server --data data --port 8080)"))}

  prepare
  {:doc "convert the encoder checkpoints into data/ (LEV_CHECKPOINTS / LEV_DATA, ~/.config/lev/config.edn :checkpoints-home / :data, else ../laya and data)"
   :depends [kernels]
   :task (shell "jolt" "-M:prepare")}

  clean-native
  {:doc "remove the compiled kernel library"
   :task (do (fs/delete-if-exists "native/liblev_kernels.dylib")
             (fs/delete-if-exists "native/liblev_kernels.so")
             (fs/delete-if-exists "native/liblev_kernels.a")
             (println "removed kernel libs"))}}

 :aliases {:test {:extra-paths ["test"]
                  :main-opts ["-m" "lev.test-runner"]}
           :run {:main-opts ["-m" "lev.run"]}
           :prepare {:main-opts ["-m" "lev.prepare"]}
           :serve {:main-opts ["-m" "lev.server"]}
           :mcp {:main-opts ["-m" "lev.server" "--mcp"]}
           :calibrate {:main-opts ["-m" "lev.calibrate"]}}}
